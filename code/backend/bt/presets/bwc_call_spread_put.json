{
  "name": "bwc_call_spread_put",
  "underlying": "SPY",
  "capital": 25000,
  "start": "2013-01-02",
  "end": "2026-04-17",
  "params": {
    "long_call_delta": 0.35,
    "short_call_delta": 0.15,
    "put_delta": 0.2,
    "put_dte": 21,
    "exit_dte": 21,
    "take_profit": 0.5,
    "stop_loss": 3.0,
    "min_premium": 0.1
  },
  "legs": [
    {
      "name": "long_call",
      "action": "buy",
      "right": "call",
      "dte": 45,
      "delta": 0.35
    },
    {
      "name": "short_call",
      "action": "sell",
      "right": "call",
      "dte": 45,
      "delta": 0.15
    },
    {
      "name": "short_put",
      "action": "sell",
      "right": "put",
      "dte": 21,
      "delta": 0.2
    }
  ],
  "entry": {
    "frequency": "daily",
    "max_active": 1
  },
  "exits": {
    "rules": [
      {
        "when": "dte_of('long_call') <= exit_dte",
        "reason": "reached days to expiration limit"
      },
      {
        "when": "pnl_pct >= take_profit",
        "reason": "take profit"
      },
      {
        "when": "pnl_pct <= -stop_loss",
        "reason": "stop loss"
      },
      {
        "when": "premium < min_premium",
        "reason": "net premium too small to manage",
        "priority": 20
      }
    ]
  }
}
