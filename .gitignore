# Secrets and bulk data — whole folders, anchored to the repo root. The leading
# slash matters: a bare `data/` would also match nested code dirs.
/env/
/data/

# Belt and braces. No template is tracked: the app reads credentials from the
# encrypted user DB, never from env/, so there is nothing to show an example of.
*.env
*.db
*.db-journal
*.npz
*.csv.gz
*.parquet

# Virtualenvs live in Claude/venvs/, but block them anyway.
.venv/
venv/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Node / Electron
node_modules/
code/app/out/
code/app/dist/
*.tsbuildinfo

# Run logs. The e2e appends every run to code/app/e2e/e2e.log so a killed or
# piped run does not lose its output; it is a local diagnostic, never shared.
*.log

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
