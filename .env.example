# Secrets template. Copy to env/<something>.env and fill in real values.
# `.gitignore` blocks env/ and *.env; this .example file is the only one tracked.
# Never put a real credential in this file.
#
# YOU PROBABLY DO NOT NEED THIS. The app does not read env/ at runtime — broker
# credentials are entered in Accounts and stored encrypted in the user database,
# unlocked by your profile password. These entries are only for scripts and
# tooling that run outside the app.

# env/alpaca.env — Alpaca paper/live trading + market data + news
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
# APCA_API_BASE_URL=https://paper-api.alpaca.markets

# env/tastytrade.env — TastyTrade open API (sandbox or production)
# TT_USERNAME=
# TT_PASSWORD=
# TT_ENVIRONMENT=sandbox

# env/app.env — application-level secrets (generated at install time in production)
# APP_SECRET_KEY=
# APP_DB_ENCRYPTION_KEY=
